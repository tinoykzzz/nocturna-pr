# Supabase - Copia este archivo a .env y rellena con tus credenciales
# Obtén las credenciales en: https://supabase.com/dashboard → Tu proyecto → Settings → API

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Storage: bucket público para fotos del catálogo (créalo en Supabase → Storage; políticas en supabase-storage-bucket.sql)
# Por defecto el código usa el bucket "product-images" si no defines esta variable:
# VITE_SUPABASE_STORAGE_BUCKET=product-images

# Admin / intranet:
# - Sin variable: en `npm run dev` → modo demo (admin / 123). En `npm run build` → production.
# - demo: fuerza login local aunque sea build (solo para pruebas)
# - production: Supabase Auth + tabla admin_emails
# VITE_ADMIN_MODE=production

# Solo si VITE_ADMIN_MODE=demo (o para sobrescribir credenciales demo en dev)
# VITE_DEMO_ADMIN_EMAIL=admin
# VITE_DEMO_ADMIN_PASSWORD=123

# Opcional: URL de una Supabase Edge Function (o backend) para enviar avisos masivos a suscriptores.
# El cliente puede hacer POST con { subject, body } y Authorization: Bearer <JWT sesión>.
# VITE_NEWSLETTER_BROADCAST_URL=https://tu-proyecto.supabase.co/functions/v1/send-newsletter
